# Top-most EditorConfig file
root = true

# Global formatting settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown and JSON formatting
[*.{md,json}]
indent_size = 2

# C# Code Conventions & Style
[*.cs]
indent_size = 4
indent_style = space

# Modern C# preferences
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# Usings organization
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Analyzer general adjustments
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1848.severity = suggestion

# ------------------------------------------------------------------------------
# Test Projects Configuration (naming conventions & pragmatic test patterns)
# ------------------------------------------------------------------------------
[tests/**/*.cs]
# Allow underscores in test names (Given_When_Then pattern)
dotnet_diagnostic.CA1707.severity = none
# Allow Thread.Sleep in test timing scenarios
dotnet_diagnostic.S2925.severity = none
# Allow empty blocks in test catches
dotnet_diagnostic.S108.severity = none
# Relax null-forgiving operator checks in tests
dotnet_diagnostic.S8969.severity = none
# Relax culture and string comparison rules in tests
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.S1118.severity = none
dotnet_diagnostic.S3881.severity = none
dotnet_diagnostic.S4136.severity = none
dotnet_diagnostic.S2365.severity = none
dotnet_diagnostic.S1066.severity = none
dotnet_diagnostic.S4144.severity = none
dotnet_diagnostic.S3458.severity = none
dotnet_diagnostic.S3358.severity = none
dotnet_diagnostic.S2326.severity = none
dotnet_diagnostic.S1481.severity = none
dotnet_diagnostic.S3903.severity = none
dotnet_diagnostic.S112.severity = none
dotnet_diagnostic.S6966.severity = none
dotnet_diagnostic.RCS1102.severity = none
dotnet_diagnostic.RCS1242.severity = none
dotnet_diagnostic.RCS1075.severity = none

# ------------------------------------------------------------------------------
# Example & Sample Projects Configuration
# ------------------------------------------------------------------------------
[examples/**/*.cs]
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.S1118.severity = none
dotnet_diagnostic.S112.severity = none
dotnet_diagnostic.S3903.severity = none
dotnet_diagnostic.S6966.severity = none
dotnet_diagnostic.S8969.severity = none
dotnet_diagnostic.RCS1102.severity = none
