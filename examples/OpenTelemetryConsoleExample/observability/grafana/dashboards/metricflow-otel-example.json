{
  "uid": "metricflow-otel-example",
  "title": "MetricFlow - OpenTelemetry Console Example",
  "tags": ["metricflow", "opentelemetry", "dotnet"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(service_name)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Telemetry Metrics (Duration, Executions & Exceptions)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "title": "Total Operations Executed",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time({__name__=~\"(ProcessOrderBatch|CustomerLookup|ValidatePayment)_total\", service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Payment Exceptions",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time(ValidatePayment_exceptions_total{service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Overall Avg Duration",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time({__name__=~\".*_duration_milliseconds_sum\", service_name=~\"$service\"}[1h])) / sum(last_over_time({__name__=~\".*_duration_milliseconds_count\", service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "p95 Operation Duration",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (last_over_time({__name__=~\".*_duration_milliseconds_bucket\", service_name=~\"$service\"}[1h])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 150 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Average Duration by Operation (ms)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{operation}}",
          "expr": "sum by (operation) (last_over_time({__name__=~\".*_duration_milliseconds_sum\", service_name=~\"$service\"}[1h])) / sum by (operation) (last_over_time({__name__=~\".*_duration_milliseconds_count\", service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 6,
      "title": "Operation Executions Over Time (by Status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{operation}} ({{status}})",
          "expr": "sum by (operation, status) ({__name__=~\"(ProcessOrderBatch|CustomerLookup|ValidatePayment)_total\", service_name=~\"$service\"})"
        }
      ]
    },
    {
      "id": 200,
      "title": "Functional Metrics (Pure Business Events, Items & Dimensions)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "id": 7,
      "title": "Orders Placed (Record)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time(OrderPlaced_total{service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "id": 8,
      "title": "Items Sold (Increment)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time(ItemsSold_total{service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 9,
      "title": "Batch Items Processed",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time(ProcessOrderBatch_items_total{service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      }
    },
    {
      "id": 10,
      "title": "Orders Placed by Plan",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{plan}}",
          "expr": "sum by (plan) (last_over_time(OrderPlaced_total{service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 11,
      "title": "Items Processed by Region",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{region}}",
          "expr": "sum by (region) (last_over_time(ProcessOrderBatch_items_total{service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 12,
      "title": "Customer Lookup Cardinality Guard (MaxUniqueTagValues = 3)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{customer_id}}",
          "expr": "sum by (customer_id) (last_over_time(CustomerLookup_total{service_name=~\"$service\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ]
}
